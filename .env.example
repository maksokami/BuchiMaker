# Copy this file to .env and adjust as needed. `docker compose` reads .env
# automatically — no extra flags required.

# CORS: origins allowed to call the backend API from a browser.
# Only matters if the frontend talks to the backend cross-origin (i.e. you've
# overridden API_BASE_URL below to an absolute URL instead of the default
# same-origin nginx proxy) — the default docker-compose setup never sends a
# cross-origin request at all, so this is effectively unused out of the box.
# If you do go cross-origin, restrict this to your real frontend origin(s),
# comma-separated, e.g.:
#   ALLOW_ORIGINS=https://dashboards.example.com
# See the README's "Security recommendations" section for details.
ALLOW_ORIGINS=*

# Authentication seed: ALLOW/DENY, only consulted the very first time the
# app runs (before settings/general.yaml exists). After that, the Settings >
# Access tab's "Allow Anonymous Access" toggle is the sole runtime control —
# this env var is ignored. docker-compose.yml defaults this to ALLOW so a
# fresh install works immediately; set DENY (or flip the UI toggle later)
# once OIDC is configured below and in Settings > SSO.
# ANONYMOUS_USER=ALLOW

# Optional: preconfigure OIDC/SSO instead of using the Settings > SSO tab —
# useful for a GitOps-style deployment. Each only takes effect if the
# corresponding field hasn't already been saved via the UI. All four must be
# set (plus a matching redirect URI registered on the identity-provider
# client) for /auth/login to work. Example values for a Keycloak realm:
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/buchimaker
# OIDC_CLIENT_ID=buchimaker
# OIDC_CLIENT_SECRET=change-me-to-a-real-secret
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Where the frontend container should send API requests (baked into
# frontend/config.js at container start — see frontend/entrypoint.sh).
# Defaults to a same-origin relative path — nginx proxies /api/ and /auth/
# straight to the backend container (frontend/nginx.conf), which is what
# makes the SSO session cookie work with zero per-request code changes.
# Only override this to an absolute URL if you're deploying the backend
# somewhere nginx can't reach it — see ALLOW_ORIGINS above if you do.
API_BASE_URL=/api/v1

# Redis auth: empty by default, meaning both the redis service and the
# backend run with no password — fine for a single local machine, not fine
# for anything else. Set this to a real secret for any deployment beyond
# your own machine; docker-compose.yml wires the same value into both the
# redis service's `--requirepass` and the backend's REDIS_PASSWORD env var,
# so setting it here is the only step required. See the README's "Security
# recommendations" section — for a real cloud deployment, prefer sourcing
# this from your cloud's secret manager instead of a plaintext .env file.
# REDIS_PASSWORD=change-me-to-a-real-secret

# ── Host-side port overrides ────────────────────────────────────────────
# Change these if the defaults collide with something else already running
# on your machine. These only change the HOST side of the mapping — the
# ports the containers listen on internally are fixed.
API_HOST_PORT=8000
HEALTH_HOST_PORT=35400
REDIS_HOST_PORT=6379
FRONTEND_HOST_PORT=3000
